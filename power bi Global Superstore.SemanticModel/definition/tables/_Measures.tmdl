		displayFolder: 5 Colors (card text)
		lineageTag: aa38b2e1-723a-47bd-a8c5-aeab5c8e161c

	measure 'Orders Trend Up' = VAR yoy = CALCULATE([Orders YoY %], REMOVEFILTERS(Dim_Date[Month Name]), REMOVEFILTERS(Dim_Date[Month Number])) RETURN IF(yoy >= 0, [Total Orders])
		formatString: #,0
		displayFolder: 6 Trend lines
		lineageTag: 54c4c8df-b652-4588-ba9a-18ce9740394a

	measure 'Orders Trend Down' = VAR yoy = CALCULATE([Orders YoY %], REMOVEFILTERS(Dim_Date[Month Name]), REMOVEFILTERS(Dim_Date[Month Number])) RETURN IF(yoy < 0, [Total Orders])
		formatString: #,0
		displayFolder: 6 Trend lines
		lineageTag: f6cdb716-0391-4fee-b8fd-d4e48a9e6b18

	measure 'Average Order Value YoY Color' = IF([Average Order Value YoY %] < 0, "#F0696B", "#4FD1A0")
		displayFolder: 5 Colors (card text)
		lineageTag: 7005dfa1-1cb7-4c4d-806a-52293eaf912b

	measure 'Average Order Value Trend Up' = VAR yoy = CALCULATE([Average Order Value YoY %], REMOVEFILTERS(Dim_Date[Month Name]), REMOVEFILTERS(Dim_Date[Month Number])) RETURN IF(yoy >= 0, [Average Order Value])
		formatString: \$#,0.00
		displayFolder: 6 Trend lines
		lineageTag: 74b352a9-7d1b-4ede-9816-9f8a300f6dba

	measure 'Average Order Value Trend Down' = VAR yoy = CALCULATE([Average Order Value YoY %], REMOVEFILTERS(Dim_Date[Month Name]), REMOVEFILTERS(Dim_Date[Month Number])) RETURN IF(yoy < 0, [Average Order Value])
		formatString: \$#,0.00
		displayFolder: 6 Trend lines
