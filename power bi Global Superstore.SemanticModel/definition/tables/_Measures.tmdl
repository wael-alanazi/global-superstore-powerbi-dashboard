	measure 'Profit Color' = IF([Total Profit] < 0, "#D64545", "#22A06B")
		displayFolder: 5 Colors (card text)
		lineageTag: 158f6312-3c69-46c3-880e-154e43b76163

	measure 'Total Loss' = CALCULATE(SUM(Fact_Orders[Profit]), Fact_Orders[Profit] < 0)
		formatString: \$#,0;-\$#,0
		displayFolder: 7 Profitability
		lineageTag: 240e572d-e987-4da0-b13f-b7db77eb74ee

	measure 'Loss-Making Lines %' = DIVIDE(CALCULATE(COUNTROWS(Fact_Orders), Fact_Orders[Profit] < 0), COUNTROWS(Fact_Orders))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 7 Profitability
		lineageTag: 477718ad-b732-4ebf-901f-80a723d3c6e9

	measure 'Avg Discount %' = AVERAGE(Fact_Orders[Discount])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 7 Profitability
		lineageTag: 46494d73-c321-42dc-affe-a6d71a33575e

	measure 'Loss-Making Sub-Categories' = COUNTROWS(FILTER(VALUES(Dim_Products[Sub-Category]), [Total Profit] < 0))
		formatString: #,0
		displayFolder: 7 Profitability
		lineageTag: 6895f95b-724d-4495-8a73-5b4b0238eb6f

	measure 'Margin Heat Color' = VAR m = [Profit Margin %] RETURN IF(ISBLANK(m), BLANK(), SWITCH(TRUE(), m < 0, "#A64B50", m < 0.05, "#204F97", m < 0.10, "#2A62B8", m < 0.15, "#2D6ED2", "#4F8EE0"))
		displayFolder: 5 Colors (card text)
		lineageTag: 3f2b6cca-1d4f-4fe4-8dee-c89aad77296a

	measure 'Profit Cell Color' = IF([Total Profit] < 0, "#F0696B", "#4FD1A0")
		displayFolder: 5 Colors (card text)
		lineageTag: 3c6aea31-b8e7-424f-8c7c-1cb15a631b30

	measure 'Profit Cell Back' = IF([Total Profit] < 0, "#4F2A3A", "#1B4A7A")
		displayFolder: 5 Colors (card text)
		lineageTag: 64f240ad-7c2e-4e85-a8df-722659310600

	measure 'Margin Row Color' = VAR m = [Profit Margin %] VAR avg = CALCULATE([Profit Margin %], REMOVEFILTERS(Dim_Date[Month Name]), REMOVEFILTERS(Dim_Date[Month Number])) RETURN IF(m < 0, "#F0696B", IF(m >= avg, "#4FD1A0", "#90ABD5"))
		displayFolder: 5 Colors (card text)
		lineageTag: 80ba911a-67fd-4450-910b-93783d435116

	measure 'Top Product Color' = VAR r = RANKX(ALLSELECTED(Dim_Products[Product Name]), [Total Sales]) RETURN SWITCH(TRUE(), r = 1, "#CCD6E5", r <= 3, "#90ABD5", r <= 6, "#2D6ED2", "#204F97")
		displayFolder: 5 Colors (card text)
		lineageTag: f2f532bf-ecbc-4050-a959-a74f657c1da6

	measure 'Profit Tier Color' = VAR p = [Total Profit] VAR best = MAXX(ALLSELECTED(Dim_Products[Sub-Category]), [Total Profit]) VAR share = DIVIDE(p, best) RETURN SWITCH(TRUE(), p < 0, "#F0696B", share >= 0.66, "#CCD6E5", share >= 0.33, "#90ABD5", "#2D6ED2")
		displayFolder: 5 Colors (card text)
		lineageTag: 22fb670f-f34d-49a6-9378-65240ff12d17

	measure 'Avg Sales per Customer' = DIVIDE([Total Sales], [Total Customers])
		formatString: \$#,0
		displayFolder: 8 Customers
		lineageTag: 73958c4a-2539-4ac2-a9b0-76c4c6301186

	measure 'Orders per Customer' = DIVIDE([Total Orders], [Total Customers])
		formatString: 0.0
		displayFolder: 8 Customers
		lineageTag: 362ad5e8-dd30-4050-b625-422cad82f2b1

	measure 'Profit per Customer' = DIVIDE([Total Profit], [Total Customers])
		formatString: \$#,0
		displayFolder: 8 Customers
		lineageTag: fae7b726-b5e3-448b-a179-bfa6911aed7c

