table ClusterMappingTable
	isHidden
	isPrivate
	lineageTag: 75bb8ec7-7fdc-4243-a8c1-ef1d93cf7f98

	column Customer_ID
		lineageTag: fd3fb010-61ba-40d0-8dda-4c59af7357c3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Customer_ID]

		annotation SummarizationSetBy = Automatic

