	partition ClusterMappingTable = calculated
		mode: import
		source = ```
				VAR __DS0Core = 
					SUMMARIZECOLUMNS(
						'Dim_Customers'[Customer ID],
						"Total_Orders", '_Measures'[Total Orders],
						"Total_Sales", '_Measures'[Total Sales]
					)
				
				VAR __DataTransformT0 = 
					KMeansClustering(
						SELECTCOLUMNS(
							__DS0Core,
							"Customer_ID", 'Dim_Customers'[Customer ID],
							"Total_Orders", [Total_Orders],
							"Total_Sales", [Total_Sales]
						),
						{("[Customer_ID]", "Item"),
							("[Total_Orders]", "Attribute"),
							("[Total_Sales]", "Attribute")},
						{("[Customer_ID]", BLANK()),
							("ClusterId", "ClusterId")},
						4
					)
				
				RETURN __DataTransformT0
				```
			retainDataTillForceCalculate

	annotation ClusterMappingTable = true

	annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Dim_Customers","TableItemName":"Customer clusters","ObjectType":4},"LinkType":"UsedInGroup"}]

