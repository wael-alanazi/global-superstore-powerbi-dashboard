	/// Clusters for Customer ID
	column 'Customer clusters' = ```
			VAR __ClusterValue = 
				LOOKUPVALUE(
					'ClusterMappingTable'[ClusterId],
					'ClusterMappingTable'[Customer_ID],
					'Dim_Customers'[Customer ID]
				)
			
			RETURN
				SWITCH(
					__ClusterValue,
					1,
					"Occasional",
					2,
					"Champions",
					3,
					"Low Value",
					4,
					"Regular",
					BLANK(),
					BLANK(),
					CONCATENATE("Cluster", __ClusterValue)
				)
			```
