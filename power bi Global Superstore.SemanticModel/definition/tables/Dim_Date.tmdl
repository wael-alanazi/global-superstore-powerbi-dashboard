table Dim_Date
	lineageTag: ca12c167-78cf-407c-9d34-a1eee0933954
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: 80df3c59-6948-4b0a-bef0-f399c23c255e
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 4dcd66ef-d431-436b-97b4-bd7996463975
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column Quarter
		dataType: string
		lineageTag: 4b694e04-2fca-49a7-b5d8-85b4cdca7fa7
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		dataType: int64
		formatString: 0
		lineageTag: 69e2e406-08c4-40ad-a639-dc851c6ceb30
		summarizeBy: none
		sourceColumn: Month Number

		annotation SummarizationSetBy = Automatic

	column 'Month Name'
		dataType: string
		lineageTag: f11c01ca-aff1-4379-9cfa-855afc27ca82
		summarizeBy: none
		sourceColumn: Month Name
		sortByColumn: 'Month Number'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = m
		mode: import
		queryGroup: Data_Model
		source =
				let
				    Start = #date(2011, 1, 1),
				    End = #date(2015, 12, 31),
				    Dates = List.Dates(Start, Duration.Days(End - Start) + 1, #duration(1, 0, 0, 0)),
				    Table = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}, null, ExtraValues.Error),
				    Typed = Table.TransformColumnTypes(Table, {{"Date", type date}}),
				    Year = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
				    Quarter = Table.AddColumn(Year, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    MonthNum = Table.AddColumn(Quarter, "Month Number", each Date.Month([Date]), Int64.Type),
				    MonthName = Table.AddColumn(MonthNum, "Month Name", each Date.ToText([Date], "MMMM"), type text)
				in
				    MonthName

	annotation PBI_ResultType = Table

