expression Cleaning_Geography =
		let
		    Source = stg_Superstore_Raw,
		    Selected = Table.SelectColumns(Source, {"City", "State", "Country", "Region", "Market"}),
		    Trimmed = Table.TransformColumns(Selected, {
		        {"City", Text.Trim, type text},
		        {"State", Text.Trim, type text},
		        {"Country", Text.Trim, type text},
		        {"Region", Text.Trim, type text},
		        {"Market", Text.Trim, type text}
		    }),
		    Distinct = Table.Distinct(Trimmed),
		    LocationKey = Table.AddColumn(Distinct, "Location Key",
		        each Text.Combine({[City], [State], [Country], [Region], [Market]}, "|"), type text),
		    Result = Table.ReorderColumns(LocationKey, {"Location Key", "City", "State", "Country", "Region", "Market"})
		in
		    Result
	lineageTag: 806f62a6-8adf-471e-9db2-7b99d3d9724c
	queryGroup: Cleaning

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression Cleaning_Orders =
		let
		    Source = stg_Superstore_Raw,
		
		    Selected = Table.SelectColumns(Source, {
		        "Row ID", "Order ID", "Customer ID", "Order Date", "Order Priority",
		        "Product ID", "Discount", "Sales", "Profit", "Quantity",
		        "Ship Date", "Ship Mode", "Shipping Cost",
		        "City", "State", "Country", "Region", "Market"
		    }),
		
		    Typed = Table.TransformColumnTypes(Selected, {
		        {"Row ID", Int64.Type},
		        {"Order Date", type datetime},
		        {"Ship Date", type datetime},
		        {"Discount", type number},
		        {"Sales", type number},
		        {"Profit", type number},
		        {"Quantity", Int64.Type},
		        {"Shipping Cost", type number}
		    }),
		
		    Trimmed = Table.TransformColumns(Typed, {
		        {"Order ID", Text.Trim, type text},
		        {"Customer ID", Text.Trim, type text},
		        {"Product ID", Text.Trim, type text},
		        {"City", Text.Trim, type text},
		        {"State", Text.Trim, type text},
		        {"Country", Text.Trim, type text},
		        {"Region", Text.Trim, type text},
		        {"Market", Text.Trim, type text}
		    }),
		
		    LocationKey = Table.AddColumn(Trimmed, "Location Key",
		        each Text.Combine({[City], [State], [Country], [Region], [Market]}, "|"), type text),
		
		    Result = Table.RemoveColumns(LocationKey, {"City", "State", "Country", "Region", "Market"}),
		  #"Changed column type" = Table.TransformColumnTypes(Result, {{"Order Date", type date}, {"Ship Date", type date}})
		in
		    #"Changed column type"
	lineageTag: 5eb4d362-7a90-4b78-9694-d439a1fb97a8
	queryGroup: Cleaning

	annotation PBI_ResultType = Table

